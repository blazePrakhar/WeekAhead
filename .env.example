# WeekAhead environment configuration template
#
# Do not put real passwords, API keys, tokens, or other secrets here.

# Backend
SERVER_PORT=8080

# MySQL
# Used when running Spring Boot directly from the backend directory.
DB_URL=jdbc:mysql://localhost:3307/weekahead_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=weekahead_app
DB_PASSWORD=CHANGE_ME

# MySQL Docker root password
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Flyway
# Used when running Spring Boot directly from the backend directory.
FLYWAY_MIGRATIONS_PATH=../database/migrations