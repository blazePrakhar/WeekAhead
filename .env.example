# WeekAhead environment configuration template
#
# Do not put real passwords, API keys, tokens, or other secrets here.

# Backend
SERVER_PORT=8080

# MySQL
# Used when running Spring Boot directly from the backend directory.
DB_URL=jdbc:mysql://localhost:3308/weekahead_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=weekahead_app
DB_PASSWORD=CHANGE_ME

# MySQL Docker root password
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Flyway
# Used when running Spring Boot directly from the backend directory.
FLYWAY_MIGRATIONS_PATH=../database/migrations

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite